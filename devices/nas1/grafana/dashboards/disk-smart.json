{
  "uid": "disk-smart",
  "title": "Disk Health (SMART)",
  "tags": ["disk", "smart", "hardware"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "SMART health per device",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "smartctl_device_smart_status", "legendFormat": "{{device}}", "refId": "A", "instant": true } ],
      "options": { "colorMode": "background", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" }, "1": { "text": "PASS", "color": "green" } } } ], "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 2, "type": "timeseries", "title": "Temperature",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "smartctl_device_temperature{temperature_type=\"current\"}", "legendFormat": "{{device}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "celsius", "custom": { "fillOpacity": 5, "showPoints": "never" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 60 } ] } } }
    },
    {
      "id": 3, "type": "table", "title": "Device inventory",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "smartctl_device_capacity_bytes", "format": "table", "instant": true, "refId": "A" },
        { "expr": "smartctl_device_power_on_seconds", "format": "table", "instant": true, "refId": "B" },
        { "expr": "smartctl_device_power_cycle_count", "format": "table", "instant": true, "refId": "C" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "compose_project": true, "container_id": true, "container_name": true, "container_short_id": true, "instance": true, "job": true, "block_size": true, "capacity_blocks": true }, "renameByName": { "device": "Device", "model_name": "Model", "device_type": "Type", "Value #A": "Capacity", "Value #B": "Power-on", "Value #C": "Power cycles" } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [ { "matcher": { "id": "byName", "options": "Capacity" }, "properties": [ { "id": "unit", "value": "bytes" } ] }, { "matcher": { "id": "byName", "options": "Power-on" }, "properties": [ { "id": "unit", "value": "s" } ] } ] }
    },
    {
      "id": 4, "type": "timeseries", "title": "NVMe wearout (% used)",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "smartctl_device_percentage_used", "legendFormat": "{{device}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 5, "showPoints": "never" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "NVMe available spare",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "smartctl_device_available_spare", "legendFormat": "{{device}} spare", "refId": "A" },
        { "expr": "smartctl_device_available_spare_threshold", "legendFormat": "{{device}} threshold", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "fillOpacity": 0, "showPoints": "never" } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Errors (media / critical warnings)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "smartctl_device_media_errors", "legendFormat": "{{device}} media", "refId": "A" },
        { "expr": "smartctl_device_critical_warning", "legendFormat": "{{device}} critical", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 0, "showPoints": "auto" } } }
    }
  ]
}
