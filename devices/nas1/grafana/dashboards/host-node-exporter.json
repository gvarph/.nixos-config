{
  "uid": "host-node-exporter",
  "title": "Host (Node Exporter)",
  "tags": ["host", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "CPU busy",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Memory used",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 92 } ] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Load 1m",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "node_load1", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "color": { "mode": "continuous-GrYlRd" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "node_time_seconds - node_boot_time_seconds", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "CPU usage by mode",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum by (mode)(rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval]))", "legendFormat": "{{mode}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Memory",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes", "legendFormat": "total", "refId": "A" },
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "used", "refId": "B" },
        { "expr": "node_memory_Cached_bytes + node_memory_Buffers_bytes", "legendFormat": "cache+buffers", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Network traffic",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "sum by (device)(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br.*\"}[$__rate_interval]))", "legendFormat": "rx {{device}}", "refId": "A" },
        { "expr": "-sum by (device)(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br.*\"}[$__rate_interval]))", "legendFormat": "tx {{device}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Disk I/O",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "sum by (device)(rate(node_disk_read_bytes_total{device!~\"dm-.*|loop.*\"}[$__rate_interval]))", "legendFormat": "read {{device}}", "refId": "A" },
        { "expr": "-sum by (device)(rate(node_disk_written_bytes_total{device!~\"dm-.*|loop.*\"}[$__rate_interval]))", "legendFormat": "write {{device}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 9, "type": "bargauge", "title": "Filesystem usage",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|ramfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A", "instant": true } ],
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 } ] } } }
    }
  ]
}
