{
  "uid": "docker-containers",
  "title": "Docker Containers",
  "tags": ["docker", "cadvisor"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "definition": "label_values(container_cpu_usage_seconds_total{name!=\"\"}, name)",
        "query": { "query": "label_values(container_cpu_usage_seconds_total{name!=\"\"}, name)", "refId": "vars" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Running containers",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "count(count by (name)(container_last_seen{name!=\"\"}))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null } ] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Total CPU cores in use",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[$__rate_interval]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "color": { "mode": "continuous-GrYlRd" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Total memory (working set)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum(container_memory_working_set_bytes{name!=\"\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "continuous-GrYlRd" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Container restarts (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum(increase(container_start_time_seconds{name!=\"\"}[1h]) > bool 0)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "CPU usage per container (cores)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Memory working set per container",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum by (name)(container_memory_working_set_bytes{name=~\"$container\"})", "legendFormat": "{{name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Network received per container",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum by (name)(rate(container_network_receive_bytes_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Network transmitted per container",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [ { "expr": "sum by (name)(rate(container_network_transmit_bytes_total{name=~\"$container\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "fillOpacity": 10, "showPoints": "never" } } }
    },
    {
      "id": 9, "type": "table", "title": "Per-container summary",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name=~\"$container\"}[$__rate_interval]))", "format": "table", "instant": true, "refId": "A" },
        { "expr": "sum by (name)(container_memory_working_set_bytes{name=~\"$container\"})", "format": "table", "instant": true, "refId": "B" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "renameByName": { "name": "Container", "Value #A": "CPU cores", "Value #B": "Memory" }, "excludeByName": { "Time": true } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [ { "matcher": { "id": "byName", "options": "Memory" }, "properties": [ { "id": "unit", "value": "bytes" } ] }, { "matcher": { "id": "byName", "options": "CPU cores" }, "properties": [ { "id": "unit", "value": "none" }, { "id": "decimals", "value": 3 } ] } ] }
    }
  ]
}
